# Manara backend — environment variables.
#
# Copy to `.env` locally OR set these in the PythonAnywhere Web tab.
# Set MANARA_ENV=production to enable Secure cookies + prod-only defaults.
# (config.py:_is_production also falls back to "DATABASE_URL is set" as a
# heuristic for older deploys that don't provide MANARA_ENV.)
MANARA_ENV=production

# 40+ random characters. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# SQLite for dev (default when unset), MySQL on PythonAnywhere.
#   sqlite:///instance/lms.db
#   mysql+pymysql://<user>:<pw>@<user>.mysql.pythonanywhere-services.com/<user>$manara
DATABASE_URL=

# Comma-separated origins allowed to call the API. Web demo lives on
# GitHub Pages; add any custom domains here as they're set up.
#   https://<gh-user>.github.io
CORS_ORIGINS=
