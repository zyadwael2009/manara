# Copy to ~/.pythonanywhere.env on PA and fill in the placeholders.
# `wsgi_pythonanywhere.py` loads this via python-dotenv (imported by
# config.py). Keep this file OUT of git — it holds secrets.

# Flip production defaults (SESSION_COOKIE_SECURE=True, tightened CORS).
MANARA_ENV=production

# Flask session signer. Generate once with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=<paste-64-char-random-string>

# PA gives you one free MySQL database. Create it in Databases tab as
# `default`, then take the credentials from the "MySQL settings" panel
# (the password is set once by you).
# Note: the "$" between username and DB name is required by PA's naming.
DATABASE_URL=mysql+pymysql://manaralms:<db-password>@manaralms.mysql.pythonanywhere-services.com/manaralms$default

# Comma-separated list of allowed origins for the Flutter web build.
# Include https://manaralms.pythonanywhere.com so the web build can call
# itself; add your custom domain once configured.
# The Android app doesn't need a CORS entry (it's not a browser).
CORS_ORIGINS=https://manaralms.pythonanywhere.com
